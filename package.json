{
  "name": "zsm-sdk",
  "version": "0.1.0",
  "description": "Unofficial TypeScript SDK for a multi-account sales chat workspace: session login, account list, contacts, friend requests and messages.",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "sales",
    "chat",
    "sdk",
    "multi-account",
    "n8n"
  ],
  "license": "MIT",
  "author": "zsm-sdk contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyentrunghieu98/zsm-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/nguyentrunghieu98/zsm-sdk/issues"
  },
  "homepage": "https://github.com/nguyentrunghieu98/zsm-sdk#readme",
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs test/*.test.cjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "module": "./dist/index.js"
}
